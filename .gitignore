# Terraform state files
.terraform/
terraform.tfplan
terraform.tfstate
.terraform.lock.hcl
*.backup

/terraform-provider-infoblox

.openapi-generator/
internal/service/*/.openapi-generator-ignore

# Ignore the metadata files
**/.DS_Store
.vscode/
.idea/
# Terraform variable files may hold credentials — never commit them.
# The GCP marketplace test inputs are the deliberate, reviewed exception.
*.tfvars
*.tfvars.json
!nios-public-cloud-marketplace/**/marketplace_test.tfvars
*.hcl
*.hcl.json
